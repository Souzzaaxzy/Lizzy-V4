unsafe-perm=true
fetch-retries=5
fetch-timeout=60000
package-lock=true

# O bot depende de @itsliaaa/baileys via git (github:Souzzaaxzy/baileys).
# Desde o npm 11.10 existe a opcao allow-git, e no npm 12 o padrao passou a ser
# "none": sem isto, o install morre com EALLOWGIT ("Fetching packages of type
# 'git' have been disabled").
#
# Precisa ser "all", nao "root": o npm 11.12.x tem um bug conhecido
# (npm/cli#9189) em que allow-git=root nao libera nem a dependencia git de raiz
# e o install falha igual. Verificado em npm 9.9.4, 10.9.8, 11.12.1 e 12.0.2 --
# "all" funciona em todas e versoes anteriores simplesmente ignoram a chave.
allow-git=all
