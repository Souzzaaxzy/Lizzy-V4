# Ambiente
.env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Banco de dados
dados/database/*.json
dados/database/grupos/*.json
dados/database/dono/*.json
# Subdiretórios criados em runtime (ex.: antifantasma/keys.json, que guarda as
# KEYs das instalações). Sem isto, um JSON novo em subpasta entraria no commit —
# e as KEYs vazariam junto.
dados/database/**/*.json
!dados/database/.gitkeep
!dados/database/grupos/.gitkeep
!dados/database/dono/.gitkeep

# Sessão do WhatsApp
dados/src/auth_info_baileys/
dados/src/.auth_info_baileys/

# Mídia dos reposts (runtime; expira em 24h)
dados/database/reposts-media/
dados/database/reposts-cards/

# Arquivos temporários
*.tmp
*.temp
.DS_Store

# Cookies do YouTube (nunca versionar credenciais)
youtube-cookies.txt
cookies.txt
*.cookies.txt

# Logs
logs/
*.log

# Build
dist/
build/

# Cache/temporários de APK do !apk (binários grandes, nunca versionar).
# Ficam em data/ (fora do banco), então NÃO entram no backup do atualizador.
data/apk-cache/
data/apk-tmp/
*.apk
*.part
# Diretório antigo (migrado para data/); mantido ignorado para não sobrar lixo.
dados/database/apk-cache/

# Binario do cloudflared (tunel do netplay) -- baixado pelo instalador.
# 40 MB: nunca vai para o git; ver tools/netplay-server/baixar-cloudflared.mjs
tools/netplay-server/bin/
