# ============================================
# Abyss - Configurações de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# API Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API VexAPI (vexapicom.br)
VEX_API_KEY=

# API Clash Royale (Supercell) - https://developer.clashroyale.com
CLASH_ROYALE_API_KEY=

# Chave da API SMM (revisionsmm.com)
SMM_API_KEY=

# Token do GitHub para uploads de mídia (comando !menuedicao e similares)
# Gere em: https://github.com/settings/tokens
GITHUB_UPLOAD_TOKEN=

# ============================================
# YouTube (!play / !playvid) — download via yt-dlp
# ============================================

# Caminho opcional do executável do yt-dlp (se não estiver no PATH)
# Ex.: /root/.local/bin/yt-dlp
YTDLP_PATH=

# Runtime JS do extractor do YouTube (necessário no yt-dlp moderno).
# Padrão: o próprio Node do bot (node:<caminho do node>). Só altere se precisar.

# Ex.: deno , ou um caminho absoluto
YTDLP_JS_RUNTIME=

# Solver de desafios JS do yt-dlp (EJS — pacote oficial de solvers).
YTDLP_REMOTE_COMPONENTS=ejs:github

# PO Token de um provider compatível (somente se o administrador usar um
# provedor real de PO Token — NUNCA coloque tokens fixos aqui).
# Ex.: web.gvs+... (formato yt-dlp: cliente.metodo+token)
YTDLP_PO_TOKEN=

# Cookies do YouTube (Netscape format), somente se necessário:
# use um caminho externo seguro — cookies NUNCA são commitados. Padrão: data/youtube/cookies.txt
YOUTUBE_COOKIES_FILE=
#   (legado — use YOUTUBE_COOKIES_FILE): YTDLP_COOKIES_FILE=

# Timeout por tentativa do yt-dlp em ms (padrão 180000)
YTDLP_TIMEOUT_MS=

# ============================================
# Social Profiles (!ptiktok / !pinsta / !px / !pspotify)
# ============================================

# Credenciais do provider oficial do Spotify (OPCIONAIS para !pspotify).
# O endpoint oficial GET /users/{id} foi REMOVIDO pela Spotify (fev/2026), então
# mesmo com credenciais o perfil pode vir pelo scraping público da página do
# usuário. SEM credenciais o comando funciona pelo caminho público (nome/avatar).
# Preencha só se quiser tentar o caminho oficial (dados completos, quando houver).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================
# TOPGEAR (!topgear) — experiência Rich/Web experimental
# ============================================

# Servidor local que serve HTML/JS/WASM do jogo (o botão do WhatsApp abre no
# webview). Padrões: porta 8099, host 0.0.0.0.
TOPGEAR_PORT=8099
TOPGEAR_HOST=0.0.0.0

# URL pública HTTPS que o botão do WhatsApp vai abrir. SEM ela o comando usa
# localhost e o botão NÃO abre no aparelho.
# Ex.: TOPGEAR_PUBLIC_URL=https://aleatoryconteudos.com/topgear
TOPGEAR_PUBLIC_URL=

# ============================================
# CALL (!callp / !vozp / !musicap) — pilha de mídia (lizzy-call)
# ============================================

# Quantos workers pthread o motor WASM sobe. Cada worker custa ~45 MB.
# MEDIDO: 1 = ~87 MB | 2 = ~129 MB | 3 = ~172 MB | 6 (padrão) = ~300 MB.
# Em servidor com pouca RAM (1 GB), use 1 ou 2 — senão o OOM killer mata o
# processo no meio da call (o bot reinicia sozinho, sem log).
CALL_PTHREAD_POOL_SIZE=2

# Porta com que se disca o relay. O PADRAO (sem esta env) e' deixar o MOTOR
# decidir por sessao -- `useOriginalRelayPort ?? !isMobilePrimary()`:
#   companion (dispositivo pareado, o caso do bot) -> porta ANUNCIADA
#   primary   (celular)                            -> 3480
#
# O README do pacote diz isso MEDIDO: "Measured: a companion's legs open ONLY on
# the advertised port, a mobile primary's only on 3480."
#
# E medido daqui tambem, com um binding request STUN cru contra os relays que
# aparecem no log (157.240.241.133, 57.145.3.57, 157.240.13.129, 57.144.233.57,
# 57.144.217.57): :3478 respondeu 32 bytes em TODOS, :3480 deu timeout em TODOS.
#
# Ou seja: forcar `web` (3480) num companion aponta a leg para a porta MUDA --
# era o `relay leg unanswered` / `sctp connection failed` do log. Deixe comentado.
#
# `CALL_RELAY_PORT_MODE=original` forca a porta anunciada; `web` forca a 3480.
# CALL_RELAY_PORT_MODE=original

# Desabilita IPv6 no relay (evita tentativas em rede sem rota IPv6). '0' liga.
CALL_DISABLE_IPV6=1


# ---- QUALIDADE DE AUDIO (encoder MLow) ----
# O encoder abre no padrao do pacote (15 kbps, complexidade 5, sem FEC). Estes
# ajustes sobem a qualidade SEM editar node_modules.
#
# Bitrate (bps). A banda de audio do REMB vai de 16 a 30 kbps: 30000 ja' e' o
# teto util (pedir mais nao ajuda -- o receptor manda o REMB pedindo para
# baixar). '0'/'off' volta ao padrao do pacote.
ZAPO_MLOW_BITRATE=30000
#
# Complexidade do encoder (0 a 10). MEDIDO: 10 nao custa banda (os bytes ate'
# caem) e melhora levemente o SNR. 'off' volta ao padrao (5).
ZAPO_MLOW_COMPLEXITY=10
#
# Perda esperada, em %. Acima de zero o encoder emite a copia de FEC, que
# protege contra CORTE. 'off' desliga.
ZAPO_MLOW_LOSS=10
#
# RED (copia de baixa taxa do frame anterior): reduz o corte sob perda. '0' desliga.
ZAPO_MLOW_RED=1
#
# Pos-filtro neural do decoder (melhora o TIMBRE -- o "abafado"). E' o unico
# lever real do timbre e NENHUM pacote traz o blob. Coloque o arquivo
# `mlow_companion_v1.pte` em dados/database/zapo-models/ (ou aponte aqui) para
# liga-lo; sem ele a call decodifica sem o filtro, sem quebrar.
ZAPO_MLOW_COMPANION=

# ---- PREPARO DO AUDIO (chiado) ----
# Tempo maximo (ms) que o preparo (ffmpeg) pode levar por arquivo. Passar disso,
# usa o arquivo original.
CALL_PREP_TIMEOUT_MS=60000

# Token do GitHub usado pelo sync do codigo no boot (start.js).
# Usado SO para o fetch/reset durante o sync; o remote original e restaurado depois.
# NUNCA comite este valor.
GITHUB_SYNC_TOKEN=

# Desliga o sync do codigo no boot (1 = ligado, 0 = desligado). Padrao: ligado.
LIZZY_SYNC_ON_BOOT=1

# ---- AGENTE DE VOZ NA CALL (!iap) ----
# O `!iap on` faz o bot OUVIR a call e RESPONDER em voz (STT -> LLM -> TTS).
#   ouvir  = Groq Whisper      (a chave do `!keygroq`)
#   pensar = Groq LLM          (a MESMA chave)
#   falar  = msedge-tts        (Node puro; sem chave, sem cota, sem pip/python)
# O Gemini NAO e' usado em nada aqui, e a voz nao depende de python/pip: o
# msedge-tts vem no `npm install` do bot.

# Voz do edge-tts (TTS local, sem chave e sem limite). Vozes pt-BR prontas:
# pt-BR-FranciscaNeural (feminina, padrao), pt-BR-ThalitaMultilingualNeural
# (feminina, multilingue), pt-BR-AntonioNeural (masculina).
IAP_TTS_VOICE=pt-BR-FranciscaNeural

# (opcional) Caminho do binario PYTHON `edge-tts`, usado como RESERVA da voz.
# O motor principal e' o `msedge-tts` (Node) e nao precisa de nada disto.
EDGE_TTS_PATH=

# Teto de tempo (ms) do TTS.
IAP_TTS_TIMEOUT_MS=45000

# TTL (ms) do cache NEGATIVO do edge-tts: instalou o edge-tts depois? ele volta
# a ser detectado apos este intervalo, sem reiniciar o bot.
IAP_EDGE_RETRY_MS=60000

# ---- FLUIDEZ E INTELIGENCIA DO AGENTE ----
# Silencio (ms) que FECHA a frase. NAO baixe: com menos o bot comeca a responder
# antes de a pessoa terminar (a pausa de respiracao vira "acabou") e a fala sai
# cortada/acelerada. 700 e' o valor que funciona; suba em grupo barulhento.
IAP_VAD_SILENCIO_MS=700

# Nivel de energia que conta como fala. Baixe (0.008) em audio fraco; suba
# (0.02) em ambiente ruidoso.
IAP_VAD_LIMIAR=0.012

# Quantas mensagens o agente lembra da conversa (20 = ~10 turnos).
IAP_HISTORICO_MAX=20

# Tamanho/tom das respostas. Respostas curtas = fala mais natural e mais rapida.
IAP_LLM_MAX_TOKENS=220
IAP_LLM_TEMP=0.8

# ---- IA DA CALL e TRANSCRICAO (Groq) ----
# O `!iap` (IA na call) e o `!transcrever` rodam SO' no GROQ: ouvir (Whisper) e
# pensar (LLM) na MESMA chave. O Gemini foi removido destes dois comandos --
# ele estourava o tempo no audio e dividia a cota com o resto do bot.
#
# Obtenha gratis em https://console.groq.com/keys (a chave comeca com gsk_).
#
# --- ATE' 10 CHAVES, COM TROCA AUTOMATICA ---
# O plano gratis acaba, entao da' para cadastrar varias chaves: quando a cota de
# uma estoura (429) ou ela e' invalida (401/403), a PROXIMA assume na hora.
# Os comandos sao `!keygroq` (slot 1), `!keygroq2` ... `!keygroq10`.
#
#   slot 1  -> GROQ_API_KEY      (a de sempre)
#   slot 2  -> GROQ_API_KEY_2
#   ...
#   slot 10 -> GROQ_API_KEY_10
#
# Slot sem valor e' ignorado, entao uma lista com buracos (1, 3, 5) funciona.
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
# GROQ_API_KEY_6=
# GROQ_API_KEY_7=
# GROQ_API_KEY_8=
# GROQ_API_KEY_9=
# GROQ_API_KEY_10=

# Modelo de TRANSCRICAO (ouvir). Dedicado e o mais rapido (~200x o tempo real).
# Use `whisper-large-v3` se precisar de mais precisao (um pouco mais lento).
IAP_GROQ_STT_MODEL=whisper-large-v3-turbo

# VIES de vocabulario do Whisper (campo `prompt`): ele trata isso como o texto
# anterior e ENVIESA a decodificacao. E' o que faz ele acertar "toca", "baixa",
# "figurinha" e os nomes das pessoas na call. Deixe vazio para desligar.
IAP_STT_PROMPT=

# Modelo de CONVERSA (pensar). Gratis no plano do Groq:
# openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.8-27b
IAP_GROQ_LLM_MODEL=openai/gpt-oss-120b

# MEMORIA da conversa do CHAT (!assistente): quantas mensagens ela lembra.
# Era 12 (6 idas e voltas) — curto demais, ela esquecia o que foi dito. 40 = ~20
# turnos. Aumentar custa mais token por resposta.
IA_HISTORICO=40

# Teto de tokens da RESPOSTA do chat. 900 cabe resposta normal e alguma
# explicacao; subir deixa ela mais detalhada (e mais cara).
IA_MAX_TOKENS=900

# Tetos de tempo (ms).
IAP_GROQ_TIMEOUT_MS=45000
IAP_GROQ_LLM_TIMEOUT_MS=45000

# ---- GEMINI (so' os outros comandos de IA) ----
# `!gemma`, `!phi`, `!qwen` e companhia continuam usando a chave do `!key`.
# O `!iap` NAO usa o Gemini em nada (ouvir/pensar = Groq; falar = edge-tts).
