# ============================================
# Abyss - Configurações de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# API Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API VexAPI (vexapicom.br)
VEX_API_KEY=

# API Clash Royale (Supercell) - https://developer.clashroyale.com
CLASH_ROYALE_API_KEY=

# Chave da API SMM (revisionsmm.com)
SMM_API_KEY=

# Token do GitHub para uploads de mídia (comando !menuedicao e similares)
# Gere em: https://github.com/settings/tokens
GITHUB_UPLOAD_TOKEN=

# ============================================
# YouTube (!play / !playvid) — download via yt-dlp
# ============================================

# Caminho opcional do executável do yt-dlp (se não estiver no PATH)
# Ex.: /root/.local/bin/yt-dlp
YTDLP_PATH=

# Runtime JS do extractor do YouTube (necessário no yt-dlp moderno).
# Padrão: o próprio Node do bot (node:<caminho do node>). Só altere se precisar.

# Ex.: deno , ou um caminho absoluto
YTDLP_JS_RUNTIME=

# Solver de desafios JS do yt-dlp (EJS — pacote oficial de solvers).
YTDLP_REMOTE_COMPONENTS=ejs:github

# PO Token de um provider compatível (somente se o administrador usar um
# provedor real de PO Token — NUNCA coloque tokens fixos aqui).
# Ex.: web.gvs+... (formato yt-dlp: cliente.metodo+token)
YTDLP_PO_TOKEN=

# Cookies do YouTube (Netscape format), somente se necessário:
# use um caminho externo seguro — cookies NUNCA são commitados. Padrão: data/youtube/cookies.txt
YOUTUBE_COOKIES_FILE=
#   (legado — use YOUTUBE_COOKIES_FILE): YTDLP_COOKIES_FILE=

# Timeout por tentativa do yt-dlp em ms (padrão 180000)
YTDLP_TIMEOUT_MS=

# ============================================
# Social Profiles (!ptiktok / !pinsta / !px / !pspotify)
# ============================================

# Credenciais do provider oficial do Spotify (OPCIONAIS para !pspotify).
# O endpoint oficial GET /users/{id} foi REMOVIDO pela Spotify (fev/2026), então
# mesmo com credenciais o perfil pode vir pelo scraping público da página do
# usuário. SEM credenciais o comando funciona pelo caminho público (nome/avatar).
# Preencha só se quiser tentar o caminho oficial (dados completos, quando houver).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================
# TOPGEAR (!topgear) — experiência Rich/Web experimental
# ============================================

# Servidor local que serve HTML/JS/WASM do jogo (o botão do WhatsApp abre no
# webview). Padrões: porta 8099, host 0.0.0.0.
TOPGEAR_PORT=8099
TOPGEAR_HOST=0.0.0.0

# URL pública HTTPS que o botão do WhatsApp vai abrir. SEM ela o comando usa
# localhost e o botão NÃO abre no aparelho.
# Ex.: TOPGEAR_PUBLIC_URL=https://aleatoryconteudos.com/topgear
TOPGEAR_PUBLIC_URL=
