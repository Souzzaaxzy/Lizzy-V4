# ============================================
# Abyss - Configurações de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# API Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API VexAPI (vexapicom.br)
VEX_API_KEY=

# API Clash Royale (Supercell) - https://developer.clashroyale.com
CLASH_ROYALE_API_KEY=

# Chave da API SMM (revisionsmm.com)
SMM_API_KEY=

# Token do GitHub para uploads de mídia (comando !menuedicao e similares)
# Gere em: https://github.com/settings/tokens
GITHUB_UPLOAD_TOKEN=

# ============================================
# YouTube (!play / !playvid) — download via yt-dlp
# ============================================

# Caminho opcional do executável do yt-dlp (se não estiver no PATH)
# Ex.: /root/.local/bin/yt-dlp
YTDLP_PATH=

# Runtime JS do extractor do YouTube (necessário no yt-dlp moderno).
# Padrão: o próprio Node do bot (node:<caminho do node>). Só altere se precisar.

# Ex.: deno , ou um caminho absoluto
YTDLP_JS_RUNTIME=

# Solver de desafios JS do yt-dlp (EJS — pacote oficial de solvers).
YTDLP_REMOTE_COMPONENTS=ejs:github

# PO Token de um provider compatível (somente se o administrador usar um
# provedor real de PO Token — NUNCA coloque tokens fixos aqui).
# Ex.: web.gvs+... (formato yt-dlp: cliente.metodo+token)
YTDLP_PO_TOKEN=

# Cookies do YouTube (Netscape format), somente se necessário:
# use um caminho externo seguro — cookies NUNCA são commitados. Padrão: data/youtube/cookies.txt
YOUTUBE_COOKIES_FILE=
#   (legado — use YOUTUBE_COOKIES_FILE): YTDLP_COOKIES_FILE=

# Timeout por tentativa do yt-dlp em ms (padrão 180000)
YTDLP_TIMEOUT_MS=

# ============================================
# Social Profiles (!ptiktok / !pinsta / !px / !pspotify)
# ============================================

# Credenciais do provider oficial do Spotify (obrigatórias só para !pspotify).
# Sem elas, o comando responde com mensagem de erro amigável.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ============================================
# Akinator (!akinator)
# ============================================

# O !akinator usa o ENGINE PROPRIO da Lizzy (sem Akinator.com, sem proxy, sem
# cookies). A base pequena fica no repositorio; a base GRANDE (personagens
# importados de APIs publicas) e baixada de uma URL e guardada em cache local,
# para nao pesar no clone/pull do bot.
#
# Opcional: URL da base de personagens. Aceita UMA url ou VARIAS separadas por
# virgula (as bases SOMAM). Serve para hospedar a base no SEU repositorio.
# Padrao (sem esta env): branch de dados do proprio repo.
#
# Ex. com o seu repositorio:
#   AKINATOR_BASE_URL=https://raw.githubusercontent.com/SEU_USUARIO/lizzy-akinator-base/main/characters.json
# Ex. juntando o seu com o padrao:
#   AKINATOR_BASE_URL=https://.../seu-repo/main/characters.json,https://raw.githubusercontent.com/Souzzaaxzy/Lizzy-V4/akinator-data/akinator/characters.json
AKINATOR_BASE_URL=

# ---------------------------------------------------------------------------
# MODO DO !akinator
# ---------------------------------------------------------------------------
# remoto (PADRAO) = usa SÓ o Akinator.com via `akinator-client`. E' o modo
#                   EXCLUSIVO: se o Akinator nao responder, o comando AVISA e
#                   nao joga -- nao troca para o motor proprio escondido.
#                   Precisa de internet. O Akinator fica atras do Cloudflare e
#                   costuma responder 403 para IP de VPS/datacenter; nesse caso
#                   configure um proxy em AKINATOR_PROXY.
# local           = engine proprio da Lizzy, sem rede (opcional).
# Confira com: !akinator status
AKINATOR_MODE=remoto

# Permite voltar ao engine proprio automaticamente quando o Akinator falhar.
# Desligado por padrao (o dono pediu o Akinator exclusivo).
#   AKINATOR_REMOTO_FALLBACK=local
AKINATOR_REMOTO_FALLBACK=

# Opcional no modo remoto:
# - proxy residencial (o Cloudflare costuma aceitar IP residencial):
#     AKINATOR_PROXY=http://usuario:senha@host:porta
# - ScraperAPI (se voce tiver conta): infere a chave via env
#     SCRAPERAPI_KEY=sua_chave
# - tentativas por requisicao:
#     AKINATOR_RETRIES=2
