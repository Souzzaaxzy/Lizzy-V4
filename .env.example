# ============================================
# Abyss - Configurações de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# API Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API VexAPI (vexapicom.br)
VEX_API_KEY=

# API Clash Royale (Supercell) - https://developer.clashroyale.com
CLASH_ROYALE_API_KEY=

# Chave da API SMM (revisionsmm.com)
SMM_API_KEY=

# Token do GitHub para uploads de mídia (comando !menuedicao e similares)
# Gere em: https://github.com/settings/tokens
GITHUB_UPLOAD_TOKEN=

# ============================================
# YouTube (!play / !playvid) — download via yt-dlp
# ============================================

# Caminho opcional do executável do yt-dlp (se não estiver no PATH)
# Ex.: /root/.local/bin/yt-dlp
YTDLP_PATH=

# Runtime JS do extractor do YouTube (necessário no yt-dlp moderno).
# Padrão: o próprio Node do bot (node:<caminho do node>). Só altere se precisar.

# Ex.: deno , ou um caminho absoluto
YTDLP_JS_RUNTIME=

# Solver de desafios JS do yt-dlp (EJS — pacote oficial de solvers).
YTDLP_REMOTE_COMPONENTS=ejs:github

# PO Token de um provider compatível (somente se o administrador usar um
# provedor real de PO Token — NUNCA coloque tokens fixos aqui).
# Ex.: web.gvs+... (formato yt-dlp: cliente.metodo+token)
YTDLP_PO_TOKEN=

# Cookies do YouTube (Netscape format), somente se necessário:
# use um caminho externo seguro — cookies NUNCA são commitados. Padrão: data/youtube/cookies.txt
YOUTUBE_COOKIES_FILE=
#   (legado — use YOUTUBE_COOKIES_FILE): YTDLP_COOKIES_FILE=

# Timeout por tentativa do yt-dlp em ms (padrão 180000)
YTDLP_TIMEOUT_MS=

# ============================================
# Social Profiles (!ptiktok / !pinsta / !px / !pspotify)
# ============================================

# Credenciais do provider oficial do Spotify (obrigatórias só para !pspotify).
# Sem elas, o comando responde com mensagem de erro amigável.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ============================================
# AntiFantasma (plugin remoto)
# ============================================
# Porta da API do AntiFantasma.
# NAO precisa preencher: o bot escolhe sozinho a porta publicada do runtime
# (WORKER_1/WORKER_2), que tem subdominio HTTPS proprio (work-1/work-2), e
# monta a URL correspondente. Defina aqui apenas para forcar outra porta.
ANTIFANTASMA_PORT=

# Em Pterodactyl (ex.: Bronxys) NAO precisa configurar nada: o bot usa
# SERVER_IP + SERVER_PORT, que o painel ja fornece, e o endereco vira
# http://<ip>:<porta>. Como nao ha HTTPS nessa porta, o proxy do painel
# pode nao encaminhar o trafego — nesse caso aponte um dominio seu com TLS
# em ANTIFANTASMA_PUBLIC_URL e encaminhe a porta para ele.

# URL publica HTTPS da API.
#
# NAO precisa preencher na maioria dos casos: o bot DETECTA sozinho o dominio da
# plataforma (OpenHands/RUNTIME_URL, Render, Railway, Vercel, Koyeb, Fly,
# Heroku, Azure, Codespaces). No inicio do bot a URL e o endpoint aparecem no log.
#
# Para DEFINIR MANUALMENTE pelo WhatsApp, use o comando (exclusivo do dono):
#   !seturlghost https://meuservidor.com
#   !seturlghost          (ver a URL atual e a origem)
#   !seturlghost limpar   (voltar a deteccao automatica)
# O que o comando grava TEM PRECEDENCIA sobre a variavel abaixo.
#
# Defina a variavel apenas se preferir configura-la pelo painel do host.
ANTIFANTASMA_PUBLIC_URL=
