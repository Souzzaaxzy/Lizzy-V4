# TOPGEAR — experiência Rich/Web experimental
#
# O botão do WhatsApp (nativeFlow + useWebview) abre uma URL pública dentro do
# webview. O servidor abaixo serve o HTML/JS/WASM do jogo.
#
# TOPGEAR_PORT: porta local onde o servidor sobe (padrão 8099).
# TOPGEAR_HOST: interface (padrão 0.0.0.0, para o nginx alcançar).
# TOPGEAR_PUBLIC_URL: URL pública HTTPS usada no botão. Sem ela, o comando usa
#   localhost e avisa que não abre no aparelho.
#
# Exemplo com domínio + Cloudflare:
#   TOPGEAR_PUBLIC_URL=https://aleatoryconteudos.com/topgear
#
# Nginx (proxy_pass para a porta do servidor):
#
#   location /topgear/ {
#       proxy_pass http://127.0.0.1:8099/;
#       proxy_set_header Host $host;
#       proxy_set_header X-Forwarded-Proto $scheme;
#   }
#
# O servidor já envia content-type application/wasm e os cabeçalhos de CSP
# necessários para o WebAssembly.

TOPGEAR_PORT=
TOPGEAR_HOST=
TOPGEAR_PUBLIC_URL=
