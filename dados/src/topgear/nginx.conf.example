# TOPGEAR — bloco para o nginx do servidor (141.95.98.129 / aleatoryconteudos.com)
#
# Adicione este bloco DENTRO do `server { ... }` que já atende o domínio
# aleatoryconteudos.com, e recarregue:
#
#   sudo nginx -t && sudo systemctl reload nginx
#
# O proxy aponta para o servidor do jogo que o bot sobe (TOPGEAR_PORT, padrão 8099).

location /topgear/ {
    proxy_pass http://127.0.0.1:8099/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # WebAssembly precisa do content-type certo (o servidor do bot já envia).
    proxy_hide_header Content-Security-Policy;
}
